{
  "name": "bible-character-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Bible Character Chat - Converse with Scripture-Grounded Personas",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "cd apps/bcc_server && npm run db:migrate",
    "db:seed": "cd apps/bcc_server && npm run db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
